# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key: SERVER ONLY. Never commit it, never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=case-uploads

# --- Webhook security (shared secret with whoever calls the webhook) ---
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Evolus ---
EVOLUS_MODE=mock              # mock | rest
EVOLUS_MOCK_FAIL_FIRST_N=0    # set to 1 to see the failed-task path

# real Evolus (EVOLUS_MODE=rest): Evolus dashboard -> API keys / your workflow's id
EVOLUS_BASE_URL=https://api.evolus.ai/api/v1
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=
EVOLUS_WORKFLOW_ID=
# REST mode starts the workflow, then checks for the agent's answer every EVOLUS_POLL_INTERVAL seconds for at most
# EVOLUS_POLL_TIMEOUT seconds. Measured: 245 s on one run and about 19 minutes on another (shared endpoint), so raise the
# timeout for a demo (for example 600). Approving a case waits for this, so the browser request can take minutes.
# EVOLUS_POLL_INTERVAL=5
# EVOLUS_POLL_TIMEOUT=240

# --- Misc ---
MAX_UPLOAD_MB=10
USE_IN_MEMORY_DB=false        # true = run without Supabase (data lost on restart)

# --- AMD Token Factory (shared by the whole team: 30 requests/min, 8 concurrent) ---
TOKENFACTORY_BASE_URL=
TOKENFACTORY_API_KEY=
TOKENFACTORY_MODEL=MiMo-V2.6-Flash
# TOKENFACTORY_JSON_SCHEMA=true   # strict json_schema: the live server currently rejects it (HTTP 400)

# --- Dual detector: DEMO SETUP (the CODE default is off; this example turns it on for the demo) ---
# The CNN and ONE Token Factory vision model look at every uploaded image in parallel. One model, no fallback chain,
# no voting: if the vision model fails or times out the CNN answers alone (single_detector) and the upload never breaks.
# See README "Dual detector" and docs/dual_detector_results.md.
DUAL_DETECTOR=on                        # on | off
DUAL_VISION_MODEL=Qwen3.8-Flash-Next    # alternative: Gemma-4-31B-IT (change only this line). NEVER MiMo-V2.6-Flash: it cannot see images.
DUAL_MODE=vision_primary                # DEMO setting. Code default is pair. pair | unanimous | vote | cnn_anchored | vision_primary - see README "Dual detector"
DUAL_VISION_MODEL_2=Gemma-4-31B-IT      # used by every mode except pair (they need a second vision model)
DUAL_VISION_EFFORT=none                 # none | low | omit
DUAL_VISION_TIMEOUT=60                  # seconds to wait for each detector

# --- Text model (the agent's diagnosis writer) ---
# Primary: MiMo-V2.6-Flash (TOKENFACTORY_MODEL above). If it times out, returns HTTP 5xx / 429 after the retries, an empty
# answer, invalid JSON, or a recommendation whose evidence quote is not in the cited manual text, the backup is tried ONCE
# (same Token Factory URL and key). If the backup fails too, the case shows "recommendation unavailable" with the detector
# results and the manual citation, and a human decides. The result says which model wrote it, e.g.
# "written by DeepSeek-V4-Flash (fallback)".
TEXT_FALLBACK_MODEL=DeepSeek-V4-Flash
TEXT_FALLBACK_EFFORT=none
