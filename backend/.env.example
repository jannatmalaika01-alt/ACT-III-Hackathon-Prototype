# =====================================================================================================================
#  backend/.env.example     copy to backend/.env   (backend/.env is git-ignored: never commit it, never paste a key anywhere else)
#
#  PART 1 is the DEFAULT: everything below it runs with NO keys (mock Evolus, in-memory database, offline recommendation writer).
#  PART 2 is REAL MODE, an opt-in: uncomment only what you have keys for. Every variable the backend reads is listed here.
#  With Docker you do not even need this file: `docker compose up --build` uses the same defaults (docker/defaults.env).
# =====================================================================================================================

# ---------------------------------------------------------------------------------------------------------------------
#  PART 1: DEFAULTS (no keys needed)
# ---------------------------------------------------------------------------------------------------------------------
EVOLUS_MODE=mock                  # mock = fake Evolus task ids (MOCK-TASK-0001); rest = the real Evolus workflow (part 2)
USE_IN_MEMORY_DB=true             # true = no database, data is lost on restart; false needs Supabase (part 2)
WEBHOOK_SECRET=change-me-to-a-long-random-string   # signs status webhooks sent to POST /webhooks/case-status
MAX_UPLOAD_MB=10                  # largest accepted upload
OFFLINE_WRITER=auto               # auto = with no LLM key the recommendation is the manual's own "Action Required" step, labelled as a
                                  #        template (not an AI answer); off = show "recommendation unavailable" instead
EVOLUS_MOCK_FAIL_FIRST_N=0        # mock mode only: set to 1 to see the failed-task and Retry path

# ---------------------------------------------------------------------------------------------------------------------
#  PART 2: REAL MODE (opt-in). Uncomment and fill in what you have.
# ---------------------------------------------------------------------------------------------------------------------

# --- AMD Token Factory: the AI models (shared key: 30 requests/minute and 8 at a time for the whole team) -------------
# TOKENFACTORY_BASE_URL=                      # the OpenAI-compatible base URL from the Token Factory page
# TOKENFACTORY_API_KEY=                       # your key
# TOKENFACTORY_MODEL=MiMo-V2.6-Flash          # the text model that writes the diagnosis
# TOKENFACTORY_REASONING_EFFORT=low           # low | none | omit (a model that rejects the value falls back one step)
# TOKENFACTORY_JSON_SCHEMA=                   # true = try a strict JSON schema (the live server currently rejects it for MiMo)
# TEXT_FALLBACK_MODEL=DeepSeek-V4-Flash       # backup writer, tried ONCE if the first one times out, errors, or fails the citation check
# TEXT_FALLBACK_EFFORT=none

# --- Dual detector: the CNN plus Token Factory vision models look at every photo -----------------------------------------
# DUAL_DETECTOR=on                            # on | off (default off). Needs the Token Factory key above.
# DUAL_MODE=vision_primary                    # pair (code default) | unanimous | vote | cnn_anchored | vision_primary (our recommended mode)
# DUAL_VISION_MODEL=Qwen3.8-Flash-Next        # first vision model. NEVER MiMo-V2.6-Flash: it accepts images but cannot see them.
# DUAL_VISION_MODEL_2=Gemma-4-31B-IT          # second vision model (every mode except pair)
# DUAL_VISION_EFFORT=none                     # none | low | omit
# DUAL_VISION_TIMEOUT=60                      # seconds to wait for each detector before leaving it out

# --- Evolus: a real maintenance task from an approved case (the workflow runs an agent that uses our manuals) -----------
# EVOLUS_MODE=rest                            # overrides the mock default above
# EVOLUS_BASE_URL=https://api.evolus.ai/api/v1
# EVOLUS_API_KEY=                             # Evolus workspace -> API keys
# EVOLUS_APPLICATION_ID=
# EVOLUS_WORKFLOW_ID=                         # the workflow must be switched ON in Evolus
# EVOLUS_POLL_INTERVAL=5                      # seconds between checks for the agent's answer
# EVOLUS_POLL_TIMEOUT=600                     # give up waiting after this many seconds (measured: 245 s on one run, ~19 min on another)
# EVOLUS_BACKGROUND=true                      # approving returns at once and the wait runs in the background (page shows progress)
#                                             # a timed-out case keeps its run id and "Retry" RESUMES it (see docs/evolus_integration.md)

# --- Supabase: a real database and file storage instead of the in-memory one --------------------------------------------
# USE_IN_MEMORY_DB=false                      # overrides the default above
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=                  # SERVER ONLY. Never commit it, never put it in the frontend.
# STORAGE_BUCKET=case-uploads                 # run backend/supabase/migrations/001_init.sql once first

# --- Other LLM providers, tried AFTER Token Factory if it fails (all optional) --------------------------------------------
# LOCAL_LLM_BASE_URL=                         # for example a vLLM server on your own GPU: http://HOST:8000/v1
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_MODEL=
# GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b               # the Groq model name
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Tuning and paths (the defaults are fine) -------------------------------------------------------------------------------
# LLM_TIMEOUT=120                             # seconds for one model call
# LLM_MAX_CONCURRENT=4                        # model calls at the same time (Token Factory allows 8 for the whole team)
# EMBEDDER=auto                               # auto | minilm | tfidf: how manual pages are searched (auto falls back to tfidf offline)
# RAG_MIN_SCORE=0.08                          # a manual passage scoring below this is not trusted as evidence
# UPLOAD_CACHE_DIR=                           # where uploaded files are kept for the detector (default backend/.upload_cache)
# FEEDBACK_DIR=                               # where human-approved photos are saved for a later retrain (default data/feedback)
